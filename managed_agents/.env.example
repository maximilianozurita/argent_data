# Credenciales y endpoints — copiá este archivo a .env y completá los valores.
# NO commitees el .env real (ya está en .gitignore).

# API key de Anthropic (https://platform.claude.com/).
ANTHROPIC_API_KEY=

# URL pública del servidor MCP (HTTP/SSE) que expone las series económicas.
# El MCP debe estar levantado y expuesto por URL ANTES de correr el orquestador.
# Ej.: https://tu-tunel.ngrok.app/sse
MCP_URL=

# ID de la skill custom 'snapshot-cambiario'. Opcional. Lo devuelve
# `python register_skill.py`. Si lo dejás vacío, el agente corre sin la skill.
SKILL_ID=

# Modelo del agente. Opcional. Por defecto un modelo eficiente tipo Haiku
# (claude-haiku-4-5). Subí a uno más capaz sin tocar el código, p. ej.
# AGENT_MODEL=claude-opus-4-8.
AGENT_MODEL=
