# Copiá este archivo a .env y ajustá los valores según necesites.
# NO contiene secretos: el dataset es público y no requiere autenticación.

# Interfaz donde escucha el servidor MCP dentro del contenedor.
# Debe ser 0.0.0.0 para ser alcanzable desde fuera del contenedor.
HOST=0.0.0.0

# Puerto donde se expone el servidor MCP.
PORT=8000

# URL base (sin barra final) del dataset público de datos económicos argentinos.
DATASET_BASE_URL=https://raw.githubusercontent.com/maximilianozurita/arg-financial-data/main

# Nivel de logging: DEBUG, INFO, WARNING, ERROR. Default INFO.
# Usá DEBUG para ver cada descarga HTTP al dataset en detalle.
LOG_LEVEL=INFO

# Token de ngrok (solo si usás el túnel opcional con `--profile tunnel`).
# Obtené el tuyo en https://dashboard.ngrok.com/get-started/your-authtoken
# Dejalo vacío si no usás ngrok.
NGROK_AUTHTOKEN=
